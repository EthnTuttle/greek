<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config (referenced by
  src/debug/AndroidManifest.xml): cleartext permitted ONLY to 127.0.0.1 for
  the Wave-8 local-relay nostr E2E. Everywhere else cleartext stays off
  (base-config inherits the platform default of false on targetSdk>=28).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
