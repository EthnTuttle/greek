<?xml version="1.0" encoding="utf-8"?>
<!-- Belt-and-braces alongside android:allowBackup="false": secrets at rest
     (nostr keys live in the app database). If backup is ever re-enabled,
     everything stays excluded; the app has its own scrubbing export path. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
