  {
    "id": "letters-026",
    "front": "ἁ",
    "back": "Rough breathing over an initial vowel = /h/: ἁ- = 'ha-'. ὁ ἥλιος 'sun', ὁ ἵππος 'horse'.",
    "chapter": 4,
    "card_type": "Diacritic",
    "pos": "diacritic",
    "tags": [
